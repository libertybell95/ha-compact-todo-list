{
  "name": "ha-compact-todo-card",
  "version": "0.1.0",
  "description": "A compact, accessible to-do list card for Home Assistant dashboards.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "libertybell95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libertybell95/ha-compact-todo-list.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs",
    "todo",
    "custom-card"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "watch": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
